# Public app URL (local or deployed frontend).
VITE_APP_URL=http://localhost:3000

# Data mode: mock | supabase
VITE_DATA_MODE=mock

# Supabase (only when VITE_DATA_MODE=supabase). Never commit real keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: disable Vite HMR during automated agent edits.
# DISABLE_HMR=true
